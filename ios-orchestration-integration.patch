+import Foundation
+
+/// The bounded raw feed returned by the canvas transcript endpoint. Cursors
+/// are byte offsets in the session JSONL file; they are opaque to the UI apart
+/// from being passed back to the next request.
+struct RawTranscript: Decodable, Sendable {
+    let node: String
+    let session: String?
+    let cursor: String
+    let next: String
+    let cursorReset: Bool?
+    let cursorResetReason: String?
+    let entries: [RawTranscriptEntry]
+    let notes: RawTranscriptAttachment?
+    let summaries: RawTranscriptAttachment?
+
+    enum CodingKeys: String, CodingKey {
+        case node, session, cursor, next, entries, notes, summaries
+        case cursorReset = "cursor_reset"
+        case cursorResetReason = "cursor_reset_reason"
+    }
+}
+
+struct RawTranscriptEntry: Decodable, Sendable, Identifiable, Hashable {
+    let id: String
+    let kind: String
+    let at: Date?
+    let text: String?
+    let detail: String?
+    let phase: String?
+    let state: String?
+    let model: String?
+    let forced: Bool?
+    let tool: RawTranscriptTool?
+    let changedAt: Int64
+
+    enum CodingKeys: String, CodingKey {
+        case id, kind, at, text, detail, phase, state, model, forced, tool
+        case changedAt = "changed_at"
+    }
+
+    var title: String {
+        switch kind {
+        case "reasoning": "Thinking"
+        case "tool": tool?.name ?? "Tool"
+        case "heartbeat": "Heartbeat"
+        case "peer": "Canvas message"
+        case "compaction": "Context compaction"
+        default: kind.capitalized
+        }
+    }
+
+    var body: String? {
+        if let text, !text.isEmpty { return text }
+        if let detail, !detail.isEmpty { return detail }
+        return nil
+    }
+}
+
+struct RawTranscriptTool: Decodable, Sendable, Hashable {
+    let callID: String
+    let name: String?
+    let input: String?
+    let state: String
+    let exitCode: Int?
+    let output: String?
+    let stderr: String?
+    let error: String?
+    let started: Date?
+    let finished: Date?
+    let fullOutput: RawTranscriptFile?
+    let fullStderr: RawTranscriptFile?
+
+    var isFinished: Bool { ["done", "failed", "canceled"].contains(state) }
+
+    enum CodingKeys: String, CodingKey {
+        case name, input, state, output, stderr, error, started, finished
+        case callID = "call_id"
+        case exitCode = "exit_code"
+        case fullOutput = "full_output"
+        case fullStderr = "full_stderr"
+    }
+}
+
+struct RawTranscriptFile: Decodable, Sendable, Hashable {
+    let path: String
+    let size: Int64?
+}
+
+struct RawTranscriptAttachment: Decodable, Sendable, Hashable {
+    let file: RawTranscriptFile?
+    let text: String?
+}
+
+struct RawTranscriptSearch: Decodable, Sendable {
+    let node: String
+    let session: String?
+    let query: String
+    let text: String
+}
