+import SwiftUI
+
+/// RawTranscriptSheet is the iPhone's diagnostic view for an agent node. The
+/// normal node feed stays compact and live; this view is deliberate, bounded,
+/// and cursor-driven so a foreman can see why a child stopped without a
+/// background polling loop.
+struct RawTranscriptSheet: View {
+    let model: CanvasModel
+    let nodeID: String
+    @Environment(\.dismiss) private var dismiss
+    @State private var entries: [RawTranscriptEntry] = []
+    @State private var next: String?
+    @State private var hasMore = false
+    @State private var search = ""
+    @State private var searchText: String?
+    @State private var error: String?
+    @State private var loading = false
+    @State private var searching = false
+
+    private let pageSize = 80
+
+    var body: some View {
+        NavigationStack {
+            Group {
+                if let searchText {
+                    ScrollView {
+                        Text(searchText.isEmpty ? "No matches" : searchText)
+                            .font(.system(.footnote, design: .monospaced))
+                            .textSelection(.enabled)
+                            .frame(maxWidth: .infinity, alignment: .leading)
+                            .padding(16)
+                    }
+                } else if entries.isEmpty {
+                    ContentUnavailableView("No raw entries", systemImage: "waveform.path.ecg", description: Text("The agent has not written a transcript yet."))
+                } else {
+                    List {
+                        ForEach(entries) { entry in
+                            RawTranscriptRow(entry: entry)
+                        }
+                        if hasMore {
+                            Button {
+                                Task { await load(reset: false) }
+                            } label: {
+                                HStack {
+                                    Spacer()
+                                    if loading { ProgressView() }
+                                    Text("Load more")
+                                    Spacer()
+                                }
+                            }
+                            .disabled(loading)
+                        }
+                    }
+                    .listStyle(.plain)
+                }
+            }
+            .safeAreaBar(edge: .top) {
+                HStack(spacing: 8) {
+                    Image(systemName: "magnifyingglass")
+                        .foregroundStyle(.secondary)
+                    TextField("Search transcript", text: $search)
+                        .textInputAutocapitalization(.never)
+                        .autocorrectionDisabled()
+                        .onSubmit { Task { await runSearch() } }
+                    if !search.isEmpty {
+                        Button("Clear", systemImage: "xmark.circle.fill") {
+                            search = ""
+                            searchText = nil
+                        }
+                        .labelStyle(.iconOnly)
+                    }
+                    Button("Search", systemImage: "return") { Task { await runSearch() } }
+                        .labelStyle(.iconOnly)
+                        .disabled(search.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty || searching)
+                }
+                .padding(.horizontal, 14)
+                .padding(.vertical, 8)
+                .glassEffect(.regular, in: .capsule)
+                .padding(.horizontal, 12)
+            }
+            .safeAreaBar(edge: .bottom) {
+                if let error {
+                    Label(error, systemImage: "exclamationmark.triangle.fill")
+                        .font(.footnote)
+                        .foregroundStyle(.red)
+                        .padding(.horizontal, 14)
+                        .padding(.vertical, 8)
+                        .onTapGesture { self.error = nil }
+                }
+            }
+            .navigationTitle("Raw transcript")
+            .navigationBarTitleDisplayMode(.inline)
+            .toolbar {
+                ToolbarItem(placement: .topBarLeading) {
+                    Button("Close", systemImage: "xmark") { dismiss() }
+                }
+                ToolbarItem(placement: .topBarTrailing) {
+                    Button("Refresh", systemImage: "arrow.clockwise") {
+                        Task { await load(reset: true) }
+                    }
+                    .disabled(loading)
+                }
+            }
+        }
+        .task { await load(reset: true) }
+    }
+
+    private func load(reset: Bool) async {
+        guard !loading else { return }
+        loading = true
+        defer { loading = false }
+        if reset {
+            entries = []
+            next = "0"
+            hasMore = false
+            searchText = nil
+        }
+        do {
+            let page = try await model.rawTranscript(nodeID, after: next ?? "0", limit: pageSize)
+            entries = merge(entries, with: page.entries)
+            next = page.next
+            hasMore = page.entries.count >= pageSize && page.next != page.cursor
+            error = nil
+        } catch is CancellationError {
+        } catch {
+            self.error = error.localizedDescription
+        }
+    }
+
+    private func runSearch() async {
+        let query = search.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !query.isEmpty, !searching else { return }
+        searching = true
+        defer { searching = false }
+        do {
+            searchText = try await model.rawSearch(nodeID, query: query).text
+            error = nil
+        } catch is CancellationError {
+        } catch {
+            self.error = error.localizedDescription
+        }
+    }
+
+    private func merge(_ old: [RawTranscriptEntry], with new: [RawTranscriptEntry]) -> [RawTranscriptEntry] {
+        var byID = Dictionary(old.map { ($0.id, $0) }, uniquingKeysWith: { _, latest in latest })
+        for entry in new { byID[entry.id] = entry }
+        return byID.values.sorted {
+            if $0.changedAt != $1.changedAt { return $0.changedAt < $1.changedAt }
+            return $0.id < $1.id
+        }
+    }
+}
+
+struct RawTranscriptRow: View {
+    let entry: RawTranscriptEntry
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: 7) {
+            HStack(alignment: .firstTextBaseline, spacing: 8) {
+                Label(entry.title, systemImage: symbol(entry.kind))
+                    .font(.subheadline.weight(.semibold))
+                Spacer(minLength: 8)
+                if let at = entry.at {
+                    Text(at, format: .dateTime.hour().minute().second())
+                        .font(.caption2.monospaced())
+                        .foregroundStyle(.secondary)
+                }
+            }
+            if let body = entry.body {
+                Text(body)
+                    .font(entry.kind == "tool" ? .system(.footnote, design: .monospaced) : .subheadline)
+                    .textSelection(.enabled)
+            }
+            if let tool = entry.tool {
+                Text("\(tool.name ?? "Tool") · \(tool.state)")
+                    .font(.caption.monospaced())
+                    .foregroundStyle(tool.isFinished ? Color.secondary : Color.orange)
+                if let input = tool.input, !input.isEmpty {
+                    DisclosureGroup("Input") {
+                        Text(input)
+                            .font(.system(.caption, design: .monospaced))
+                            .textSelection(.enabled)
+                    }
+                }
+                if let output = tool.output, !output.isEmpty {
+                    DisclosureGroup("Output") {
+                        Text(output)
+                            .font(.system(.caption, design: .monospaced))
+                            .textSelection(.enabled)
+                    }
+                }
+                if let stderr = tool.stderr, !stderr.isEmpty {
+                    DisclosureGroup("stderr") {
+                        Text(stderr)
+                            .font(.system(.caption, design: .monospaced))
+                            .foregroundStyle(.orange)
+                            .textSelection(.enabled)
+                    }
+                }
+                if let full = tool.fullOutput {
+                    Text("Full output: \(full.path)")
+                        .font(.caption2.monospaced())
+                        .foregroundStyle(.secondary)
+                        .textSelection(.enabled)
+                }
+            }
+        }
+        .padding(.vertical, 5)
+    }
+
+    private func symbol(_ kind: String) -> String {
+        switch kind {
+        case "user": "person.fill"
+        case "assistant": "bubble.left.fill"
+        case "reasoning": "brain"
+        case "tool": "hammer.fill"
+        case "heartbeat": "heart.fill"
+        case "peer": "arrow.left.arrow.right"
+        case "error": "exclamationmark.triangle.fill"
+        case "compaction": "scissors"
+        default: "circle"
+        }
+    }
+}
